[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="obstacle"
3d_physics/layer_4="collectible"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/default_gravity=38.0

[rendering]

renderer/rendering_method="gl_compatibility"
; Required for Android export: Godot refuses to export without ETC2/ASTC support.
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=1
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0
scaling_3d/scale=1.0
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.0745098, 0.0901961, 0.121569, 1)
occlusion_culling/use_occlusion_culling=false

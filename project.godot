; Engine configuration file.
; Sudan Runner (Gadaman) - 3D endless runner, Godot 4.x
;
; Renderer: "gl_compatibility" is a deliberate choice: it is the only renderer
; that runs on virtually every Android GPU from 2014 onwards (GLES3/GLES2),
; boots faster on budget phones and uses less VRAM than Mobile/Vulkan.

config_version=5

[application]

config/name="Sudan Runner"
config/description="3D endless runner through the streets of Khartoum. Collect karkadeh, dodge barriers, go far."
config/version="1.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.027451, 0.0392157, 0.0431373, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/art/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://assets/art/icon.png"

[audio]

driver/enable_input=false

[autoload]

Settings="*res://scripts/core/settings.gd"
Loc="*res://scripts/core/localization.gd"
Perf="*res://scripts/core/performance_manager.gd"
Audio="*res://scripts/core/audio_manager.gd"
Game="*res://scripts/core/game_manager.gd"
Version="*res://scripts/core/version_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://scripts/": "green",
"res://scenes/": "blue"
}

[gui]

theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[input]


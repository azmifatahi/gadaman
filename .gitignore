# Godot editor cache & imported assets (regenerated by `godot --import`)
.godot/
*.translation
export_credentials.cfg

# Build output
build/
*.apk
*.aab
*.apk.idsig
android/build/
# CI signing keystore (rebuilt deterministically from cache, never committed)
ci-release.keystore
release.keystore

# Auto-built hero scene (produced at CI time from the Arabic FBX folder; do not commit)
assets/models/hero/*.tscn
assets/models/hero/*.tres
assets/models/hero/*.res
!assets/models/hero/.gitkeep
assets/models/hero/hero_report.txt

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
assets/models/hero/
